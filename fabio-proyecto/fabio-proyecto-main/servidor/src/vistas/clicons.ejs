<%
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Consultar Cliente</title>
  <link rel="stylesheet" href="C:\Users\Julian\Desktop\fabio-proyecto\fabio-proyecto-main\servidor\src\public\css\estilos.css">
</head>
<body>

  <header>
    <h1>Consultar Cliente</h1>
    <nav>
      <a href="/">Inicio</a>
      <a href="/clientes">Clientes</a>
    </nav>
  </header>

  <main>
    <form action="/cliente/clicons" method="GET">
      <label>ID del cliente:
        <input type="number" name="idclientes" required>
      </label>

      <button type="submit">Buscar</button>
    </form>

    <%
      if (typeof cliente !== 'undefined' && cliente) {
    %>
      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Apellido</th>
            <th>DNI</th>
            <th>Teléfono</th>
            <th>Email</th>
            <th>Dirección</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><%= cliente.idclientes %></td>
            <td><%= cliente.nombre %></td>
            <td><%= cliente.apellido %></td>
            <td><%= cliente.dni %></td>
            <td><%= cliente.telefono %></td>
            <td><%= cliente.email %></td>
            <td><%= cliente.direccion %></td>
          </tr>
        </tbody>
      </table>
    <%
      }
    %>

    <p><a href="/clientes">Volver al menú</a></p>
  </main>

</body>
</html>
<%
%>